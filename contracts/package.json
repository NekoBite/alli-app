{
  "name": "@alli/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ALLI on BNB Smart Chain: token, reward claims, shoe NFTs, payment router, referral payouts.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "deploy:local": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network bscTestnet",
    "abi": "hardhat run scripts/export-abi.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@types/node": "^22.20.4",
    "hardhat": "^2.29.1",
    "solc": "^0.8.28",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
