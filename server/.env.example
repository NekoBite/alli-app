# Copy to server/.env. Nothing here is bundled into the app — these are real
# server-side secrets and must never appear in the mobile client.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

DATABASE_URL=postgres://alli:alli@localhost:5432/alli

# Pepper for hashing session tokens and login codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this logs everyone out and invalidates pending login codes.
TOKEN_SECRET=

SESSION_TTL_HOURS=720
AUTH_CODE_TTL_MINUTES=10

# console prints login codes to stdout. The server refuses to boot with this in
# production, because it would put a working credential in your logs.
MAILER=console
MAIL_FROM=Alli <no-reply@trilumi.xyz>
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# Redemption stays disabled until all three are set, and /health/ready says so.
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# ALLI_TOKEN_ADDRESS=
# RELAYER_PRIVATE_KEY=

# off accepts runs from any client, emulators included. Local work only.
ATTESTATION=off

# OAuth sign-in. Optional per provider; a provider without credentials is
# refused with a 503 and the email code keeps working. The ids must match the
# ones the app was built with (EXPO_PUBLIC_* in the app's .env).
GOOGLE_CLIENT_ID=
# Only for a Web-type Google client; iOS/Android clients have no secret.
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
X_CLIENT_ID=
# Only for a confidential X client.
X_CLIENT_SECRET=

# Payments (contracts/src/PaymentRouter.sol). Purchases answer 503 payments_unavailable and planting
# stays free until the router and the quote key are set. See contracts/README.md to deploy.
CHAIN_ID=97
# PAYMENT_ROUTER_ADDRESS=
# USDT_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955   # BSC mainnet BSC-USD
# QUOTE_SIGNER_PRIVATE_KEY=     # holds QUOTE_SIGNER_ROLE on the router; KMS in production
QUOTE_TTL_SECONDS=600
# Seconds between scans for Paid events (needs BSC_RPC_URL); 0 turns the in-process watcher off.
PAYMENT_POLL_SECONDS=15

# Star exchanges through RewardClaim (voucher + claimFor) instead of a direct transfer.
# REWARD_CLAIM_ADDRESS=
# VOUCHER_SIGNER_PRIVATE_KEY=   # holds SIGNER_ROLE on RewardClaim; defaults to the quote key

# Display prices for GET /v1/wallet/prices. Never used to price a purchase.
ALLI_USD_PRICE=0
BNB_USD_PRICE=0

# Run credits granted when an account is created. 0 = the first run needs a pack or membership.
SIGNUP_RUN_CREDITS=0
