{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",

    // The modules the server shares with the app, listed one by one
    // rather than globbed. The rest of src/features/run (the store, the
    // hook, the jest specs) depends on React, Expo and the @/ alias, and must
    // stay out of the server's compile — the glob that pulled them in is
    // exactly how this coupling would rot without anyone noticing.
    "../src/features/run/types.ts",
    "../src/features/run/geo.ts",
    "../src/features/run/steps.ts",
    "../src/features/run/shoes.ts",
    "../src/features/run/rewards.ts",
    "../src/utils/time.ts",
    "../src/features/garden/types.ts",
    "../src/features/garden/rules.ts",
    "../src/features/garden/catalog.ts",
    "../src/features/garden/care.ts",
    "../src/features/quests/types.ts",
    "../src/features/quests/rules.ts",
    "../src/features/quests/quests.ts",
    "../src/features/run/credits.ts",
    "../src/features/market/types.ts",
    "../src/features/market/catalog.ts",
    "../src/features/market/rules.ts",
    "../src/features/referrals/types.ts",
    "../src/features/referrals/rules.ts",
    "../src/services/chain/eip712.ts"
  ]
}
