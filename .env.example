# Copy to .env and fill in. Anything prefixed EXPO_PUBLIC_ is bundled into the
# app binary and is therefore PUBLIC — never put a secret or a private key here.

# Backend that validates runs, holds the points ledger and signs reward claims.
EXPO_PUBLIC_API_URL=https://api.trilumi.xyz

# "mainnet" | "testnet" — which BNB Smart Chain network the app talks to.
EXPO_PUBLIC_CHAIN=testnet

# Optional override for the BSC JSON-RPC endpoint (defaults per network in
# src/services/chain/config.ts). Use a paid/dedicated node in production.
EXPO_PUBLIC_BSC_RPC_URL=

# ALLI (BEP-20) token contract. Leave blank until the token is deployed —
# the app runs against mock balances while it is unset.
EXPO_PUBLIC_ALLI_ADDRESS=

# "mock" | "live" — mock keeps every service in-memory so the UI runs with no
# backend and no chain. Flip to live once the API and contracts exist.
EXPO_PUBLIC_DATA_SOURCE=mock

# "on" | "off" — synthesise GPS and pedometer data instead of reading the
# sensors. Defaults to on while DATA_SOURCE is mock. Set it to off to walk
# around the block with real sensors while the backend is still mocked.
EXPO_PUBLIC_MOCK_SENSORS=on
